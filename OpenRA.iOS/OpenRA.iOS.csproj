<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>OpenRA.iOS</RootNamespace>
    <AssemblyName>OpenRA.iOS</AssemblyName>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">ios-arm64</RuntimeIdentifier>

    <ApplicationTitle>OpenRA</ApplicationTitle>
    <ApplicationId>net.openra.ios</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- The OpenRA native binding packages inject desktop dylibs as content
      when TargetPlatform names a desktop runtime; iOS links its own natives. -->
    <TargetPlatform></TargetPlatform>

    <!-- Keep iOS build outputs out of the shared desktop bin directory -->
    <OutputPath>bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>

    <!-- AOT-compile every assembly with interpreter fallback: the engine relies on
      System.Reflection.Emit (Sync) and runtime generic instantiation (scripting),
      which the interpreter transparently absorbs where AOT cannot. -->
    <MtouchInterpreter>-all</MtouchInterpreter>

    <!-- The engine constructs most types reflectively from mod YAML: linking would
      strip them. Revisit with SdkOnly plus trimmer roots once the port is stable. -->
    <MtouchLink>None</MtouchLink>

    <!-- The workload pins a recommended Xcode minor version; a newer installed
      Xcode is fine for development builds. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>

    <!-- Resolve P/Invokes in the binding assemblies as direct symbol references
      instead of dlsym so the linker keeps the statically-linked
      SDL2/OpenAL/FreeType/Lua archives in the executable. -->
    <MtouchExtraArgs>--dlsym:-SDL2-CS.dll --dlsym:-OpenAL-CS.dll --dlsym:-Eluant.dll --dlsym:-OpenRA.Platforms.IOS.dll</MtouchExtraArgs>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenRA.Game/OpenRA.Game.csproj" />
    <ProjectReference Include="../OpenRA.Mods.Common/OpenRA.Mods.Common.csproj" />
    <ProjectReference Include="../OpenRA.Mods.Cnc/OpenRA.Mods.Cnc.csproj" />
    <ProjectReference Include="../OpenRA.Mods.D2k/OpenRA.Mods.D2k.csproj" />
    <ProjectReference Include="../OpenRA.Platforms.IOS/OpenRA.Platforms.IOS.csproj" />
  </ItemGroup>

  <!-- The OpenRA binding packages ship desktop dylibs as content that flows in
    through project references; iOS statically links its own native builds.
    Only these exact libraries may be stripped: the .NET runtime ships its own
    support dylibs that must stay in the bundle. -->
  <PropertyGroup>
    <_DesktopNativeLibraryNames>;SDL2;soft_oal;freetype6;lua51;</_DesktopNativeLibraryNames>
  </PropertyGroup>
  <Target Name="_RemoveDesktopNativeLibraries" BeforeTargets="_ComputePublishLocation" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.dylib' And $(_DesktopNativeLibraryNames.Contains(';%(Filename);'))" />
      <ContentWithTargetPath Remove="@(ContentWithTargetPath)"
        Condition="'%(Extension)' == '.dylib' And $(_DesktopNativeLibraryNames.Contains(';%(Filename);'))" />
    </ItemGroup>
  </Target>

  <Import Project="NativeReferences.targets" />
  <Import Project="BundleData.targets" />
</Project>
